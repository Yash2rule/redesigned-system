# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With an entirely empty environment this app
# still builds, runs, and produces its full result for a visitor. Each missing
# key downgrades one feature and says so honestly on screen and at /api/health.
# Never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# Postgres connection string (Supabase or Neon free tier).
# ABSENT: funnel data goes to local JSON files under .data/, which on a
# serverless host means each instance has its own copy and a redeploy loses
# everything. This is the single most important variable to set — without it
# the validation data these probes exist to collect does not survive.
# Get one: https://supabase.com/dashboard (Settings -> Database -> Connection
# string -> URI) or https://console.neon.tech
DATABASE_URL=

# Where the file-backed store writes when DATABASE_URL is absent.
# ABSENT: <app>/.data
DATA_DIR=

# --- Payments --------------------------------------------------------------
# ABSENT (either rail): the buy button captures purchase intent instead —
# email plus chosen plan plus timestamp — and tells the visitor in plain words
# that payments are not open yet. It never pretends to charge.

# --- AI --------------------------------------------------------------------
# Only ONE of these is needed, and none of them is required.
# ABSENT: every probe still produces its complete result. The model is an
# enrichment layer over deterministic logic, never the engine. The support
# widget falls back to keyword retrieval over the FAQ and says "I don't know"
# rather than guessing.
# Get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Force a provider: anthropic | openai | gemini. Absent: first one with a key.
LLM_PROVIDER=
# Override the default model for the chosen provider.
ANTHROPIC_MODEL=

# --- Analytics -------------------------------------------------------------
# ABSENT: events still go to the store, which is what the admin dashboard
# reads. PostHog is a mirror, not the source of truth.
# Get one: https://app.posthog.com/settings/project (Project API Key)
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- Email -----------------------------------------------------------------
# Used only for magic-link sign-in, which is optional by design: every probe
# produces its first result with no account at all.
# ABSENT: sign-in is disabled. Nothing else is affected.
# Get one: https://resend.com/api-keys
RESEND_API_KEY=
AUTH_FROM_EMAIL=
# At least 16 characters. ABSENT: magic-link auth is disabled entirely rather
# than falling back to something weaker.
AUTH_SECRET=

# --- Deployment ------------------------------------------------------------
# Public base URL, used to build checkout return links.
# ABSENT: derived from the incoming request, which is correct on Vercel.
APP_BASE_URL=

# --- Payments (INR, Razorpay) ----------------------------------------------
# Get these: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Use the TEST keys (rzp_test_...) until you have taken a real payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Advance-tax reminders -------------------------------------------------
# One email per due date, ten days ahead, never a second for the same date.
# ABSENT (either): a reminder someone sets is still stored, and the page tells
# them plainly that nothing will be sent — it does not let them rely on it.
# Once a key is added, reminders that were never delivered still go out: an
# undelivered date is not recorded as sent.
# Key:  https://resend.com/api-keys
RESEND_API_KEY=
# From address, on a domain verified with Resend.
EMAIL_FROM=
# Required by /api/cron/reminders, which is wired to a daily cron in
# vercel.json and refuses every request without it.
# Generate:  openssl rand -base64 24
CRON_SECRET=
