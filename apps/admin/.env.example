# ---------------------------------------------------------------------------
# The admin dashboard is the ONE app with a required variable.
# ---------------------------------------------------------------------------

# REQUIRED. At least 8 characters.
# ABSENT: the dashboard refuses to serve anything at all. That is deliberate —
# the funnel data includes the email address of everyone who asked to be told
# when payments open, and an unset password must never mean an open door.
# Generate one:  openssl rand -base64 24
ADMIN_PASSWORD=

# Point this at the SAME database the four probe apps use, or the dashboard
# will have nothing to show. This is the reason DATABASE_URL matters: with
# file storage, each app on a serverless host writes to its own instance and
# the dashboard cannot see any of it.
DATABASE_URL=

# Only used for local development, where all five apps can share one directory.
DATA_DIR=

# Mirrored here only so /api/health can report what the deployment can do.
ANTHROPIC_API_KEY=
POSTHOG_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Needed to message the purchase-intent list from the dashboard. Without it,
# the compose screen still previews the message and downloads the CSV, and says
# plainly that nothing can be sent.
RESEND_API_KEY=
# The From address. Must be on a domain verified with Resend.
EMAIL_FROM=
